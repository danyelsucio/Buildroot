BR2_aarch64=y
BR2_cortex_a55=y
BR2_TOOLCHAIN_BUILDROOT_CXX=n
BR2_TOOLCHAIN_BUILDROOT_FORTRAN=n

BR2_SYSTEM_DHCP="eth0"
BR2_TARGET_GENERIC_HOSTNAME="cubie-a7a"
BR2_TARGET_GENERIC_ISSUE="Cubie A7A - 100% C y ASM"
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y

# KERNEL DE RADXA - ES PURO C
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/radxa/kernel.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="linux-6.1-stan-rkr3"
BR2_LINUX_KERNEL_DEFCONFIG="allwinner"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="allwinner/sun55i-a733-cubie-a7a"

# U-BOOT PURO C
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_CUSTOM_GIT=y
BR2_TARGET_UBOOT_CUSTOM_REPO_URL="https://github.com/radxa/u-boot.git"
BR2_TARGET_UBOOT_CUSTOM_REPO_VERSION="next-dev-v2024.10"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="a733-cubie-a7a"

# ROOTFS DE 64MB, SOLO BUSYBOX (C PURO)
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="64M"
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=n

