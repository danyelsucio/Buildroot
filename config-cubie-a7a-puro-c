BR2_aarch64=y
BR2_cortex_a55=y
BR2_ARM_FPU_NEON=y
BR2_TOOLCHAIN_BUILDROOT_CXX=n
BR2_TOOLCHAIN_BUILDROOT_FORTRAN=n

BR2_SYSTEM_DHCP="eth0"
BR2_TARGET_GENERIC_HOSTNAME="cubie-a7a"
BR2_TARGET_GENERIC_ISSUE="Cubie A7A - 100% C y ASM"
BR2_TARGET_GENERIC_GETTY=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y

# KERNEL RADXA - PURO C
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/radxa/kernel.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="linux-6.1-stan-rkr3"
BR2_LINUX_KERNEL_DEFCONFIG="allwinner"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# NO U-BOOT POR AHORA PARA QUE COMPILE
# BR2_TARGET_UBOOT is not set

# ROOTFS 64MB SOLO BUSYBOX - C PURO
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="64M"
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=n

# APAGADO TODO LO QUE NO SEA C
# BR2_PACKAGE_PYTHON3 is not set
# BR2_PACKAGE_LUA is not set
# BR2_TARGET_ROOTFS_TAR is not set
